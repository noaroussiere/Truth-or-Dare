# ==============================================================================
# CONFIGURATION GLOBALE - ACTION OU VÉRITÉ (avec dotenv-expand)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Variables PostgreSQL individuelles
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=truthordare
POSTGRES_SCHEMA=public

# ------------------------------------------------------------------------------
# 2. URL de connexion PostgreSQL générée via expansion de variables (${VAR})
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=${POSTGRES_SCHEMA}"

# ------------------------------------------------------------------------------
# 3. Port d'exposition de l'application
# ------------------------------------------------------------------------------
APP_PORT=3000

# ------------------------------------------------------------------------------
# 4. Authentification (Better Auth & Sécurité Origins)
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET="super-secret-key-change-in-production-1234567890"
BETTER_AUTH_URL="http://localhost:${APP_PORT}"
BETTER_AUTH_TRUSTED_ORIGINS="${BETTER_AUTH_URL},http://localhost:80,http://localhost,http://127.0.0.1:3000,http://127.0.0.1"

# ------------------------------------------------------------------------------
# 5. Connexion OIDC / Single Sign-On (Optionnel)
# ------------------------------------------------------------------------------
OIDC_ENABLED=false
NEXT_PUBLIC_OIDC_ENABLED=false

OIDC_PROVIDER_ID="oidc"
NEXT_PUBLIC_OIDC_PROVIDER_ID="oidc"
OIDC_PROVIDER_NAME="SSO / Keycloak"
NEXT_PUBLIC_OIDC_PROVIDER_NAME="SSO / Keycloak"

OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_DISCOVERY_URL=""
OIDC_SCOPES="openid,profile,email"
OIDC_ADMIN_GROUPS="truthordare admin,authentik Admins,Grafana Admins"
ADMIN_EMAILS=""
