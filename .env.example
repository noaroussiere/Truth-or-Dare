# ==============================================================================
# CONFIGURATION GLOBALE - ACTION OU VÉRITÉ
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL & Prisma
# ------------------------------------------------------------------------------
# Utilisé par Prisma et l'application pour la connexion PostgreSQL.
# Dans Docker, l'hôte est "db". En dev local sans Docker, utilisez "localhost".
DATABASE_URL="postgresql://postgres:postgres@db:5432/truthordare?schema=public"

# Variables pour le conteneur Docker PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=truthordare

# ------------------------------------------------------------------------------
# 2. Port d'exposition de l'application
# ------------------------------------------------------------------------------
APP_PORT=3000

# ------------------------------------------------------------------------------
# 3. Authentification (Better Auth & Sécurité Origins)
# ------------------------------------------------------------------------------
# Clé secrète de signature des jetons (au moins 32 caractères)
BETTER_AUTH_SECRET="super-secret-key-change-in-production-1234567890"

# URL publique de l'application
BETTER_AUTH_URL="http://localhost:3000"

# Liste d'origines de confiance séparées par des virgules (résout "Invalid origin")
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://localhost:80,http://localhost,http://127.0.0.1:3000,http://127.0.0.1"

# ------------------------------------------------------------------------------
# 4. Connexion OIDC / Single Sign-On (Optionnel)
# ------------------------------------------------------------------------------
# Activer le bouton de connexion/inscription via OIDC (true/false)
OIDC_ENABLED=false
NEXT_PUBLIC_OIDC_ENABLED=false

# Identifiant et nom d'affichage du fournisseur OIDC
OIDC_PROVIDER_ID="oidc"
NEXT_PUBLIC_OIDC_PROVIDER_ID="oidc"
OIDC_PROVIDER_NAME="SSO / Keycloak"
NEXT_PUBLIC_OIDC_PROVIDER_NAME="SSO / Keycloak"

# Paramètres du client OAuth2 / OIDC
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""

# URL de découverte OpenID (ex: https://auth.example.com/realms/master/.well-known/openid-configuration)
OIDC_DISCOVERY_URL=""

# Scopes demandés
OIDC_SCOPES="openid,profile,email"
