# 1. Base de données PostgreSQL & Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/truthordare?schema=public"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=truthordare

# 2. Port d'exposition
APP_PORT=3000

# 3. Authentification & Sécurité (Better Auth)
BETTER_AUTH_SECRET="super-secret-key-change-in-production-1234567890"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://localhost:80,http://localhost,http://127.0.0.1:3000,http://127.0.0.1"

# 4. Connexion OIDC / Single Sign-On (Optionnel)
OIDC_ENABLED=false
NEXT_PUBLIC_OIDC_ENABLED=false
OIDC_PROVIDER_ID="oidc"
NEXT_PUBLIC_OIDC_PROVIDER_ID="oidc"
OIDC_PROVIDER_NAME="SSO / Keycloak"
NEXT_PUBLIC_OIDC_PROVIDER_NAME="SSO / Keycloak"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_DISCOVERY_URL=""
OIDC_SCOPES="openid,profile,email"